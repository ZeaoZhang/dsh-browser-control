{
  "name": "dsh-browser-control",
  "version": "0.2.0",
  "description": "Chrome browser-control plugin for DeepSeek Harness: scan token-optimized page HTML, act on elements, wait for UI state, execute JS, drive tabs and CDP. Extracted from GenericAgent's TMWebDriver / simphtml.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./extension": "./extension/manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "extension/",
    "assets/",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "chrome-extension",
    "cdp",
    "web-automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  },
  "scripts": {
    "test": "node test/plugin.test.mjs && node test/protocol.test.mjs",
    "test:plugin": "node test/plugin.test.mjs",
    "test:protocol": "node test/protocol.test.mjs",
    "test:e2e": "node test/e2e-chrome.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeaoZhang/dsh-browser-control.git"
  },
  "homepage": "https://github.com/ZeaoZhang/dsh-browser-control#readme",
  "bugs": {
    "url": "https://github.com/ZeaoZhang/dsh-browser-control/issues"
  }
}
